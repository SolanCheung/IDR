  "source_surfaces": [
    {
      "id": "kernel_user_input_journal_metadata",
      "status": "CANDIDATE_ONLY",
      "evidence_refs": [
        "crates/kernel/src/runtime.rs:1940-1963"
      ],
      "finding": "Contains source=user, input_len, and input_receipt_id; lacks digest, run, turn, actor, fact families, host projection, and source governance."
    },
    {
      "id": "system_event_and_goal_state",
      "status": "PROHIBITED_RAW_SOURCE",
      "evidence_refs": [
        "crates/core-protocol/src/types.rs:42-105",
        "crates/kernel/src/runtime.rs:1160-1191",
        "crates/state-store/src/lib.rs:161-190",
        "crates/kernel/src/persistence.rs:14-64"
      ],
      "finding": "Contains or may contain free-form input, output, goal descriptions, errors, and memory records."
    },
    {
      "id": "dispatch_context_protocol",
      "status": "TYPE_ONLY_NOT_WIRED",
      "evidence_refs": [
        "crates/core-protocol/src/dispatch_context.rs:1-4",
        "crates/state-store/src/dispatch_context.rs:57-124"
      ],
      "finding": "Defines receipt, digest, logical order, and trace types but is not wired to kernel ingress, journaling, authorization, adapter, or replay and is process-local."
    },
    {
      "id": "trace_protocol",
      "status": "TYPE_ONLY_NOT_WIRED",
      "evidence_refs": [
        "crates/core-protocol/src/trace.rs:322-405"
      ],
      "finding": "Caller-provided trace fields are not bound to product ingress and default to InternalOnly privacy."
    },
    {
      "id": "production_operations_audit_export",
      "status": "UNRELATED_EXPORT",
      "evidence_refs": [
        "crates/state-store/src/production_operations/audit_export.rs:8-68"
      ],
      "finding": "Exports operational references and counts, not assessment facts; authorization reference is checked only for non-emptiness."
    },
    {
      "id": "idr_shadow_validator",
      "status": "SYNTHETIC_OR_PREBUILT_ONLY",
      "evidence_refs": [
        "crates/idr-aegis-adapter/src/lib.rs:75-97",
        "crates/idr-aegis-shadow-validator/src/lib.rs:25-45"
      ],
      "finding": "Consumes an already constructed IDR request; it does not project Aegis product events into request facts."
    }
