{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idr.local/contracts/integrations/aegis-life/ingress-receipt-trust/v1/idr-aegis-ingress-receipt-source-contract-v1.schema.json",
  "title": "AegisIngressReceiptSourceContractV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "contract_ref",
    "target_receipt_schema",
    "source_review_pin",
    "lifecycle",
    "owner",
    "identity_semantics",
    "actor_semantics",
    "content_semantics",
    "correlation_semantics",
    "logical_time_semantics",
    "receipt_digest_semantics",
    "receipt_source_binding",
    "implementation_gate",
    "contract_digest"
  ],
  "properties": {
    "schema_id": {"const": "idr.aegis.ingress-receipt-source-contract"},
    "schema_version": {"const": 1},
    "contract_ref": {"$ref": "#/$defs/refToken"},
    "target_receipt_schema": {"$ref": "#/$defs/targetReceiptSchema"},
    "source_review_pin": {"$ref": "#/$defs/sourceReviewPin"},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "owner": {"$ref": "#/$defs/owner"},
    "identity_semantics": {"$ref": "#/$defs/identitySemantics"},
    "actor_semantics": {"$ref": "#/$defs/actorSemantics"},
    "content_semantics": {"$ref": "#/$defs/contentSemantics"},
    "correlation_semantics": {"$ref": "#/$defs/correlationSemantics"},
    "logical_time_semantics": {"$ref": "#/$defs/logicalTimeSemantics"},
    "receipt_digest_semantics": {"$ref": "#/$defs/receiptDigestSemantics"},
    "receipt_source_binding": {"$ref": "#/$defs/receiptSourceBinding"},
    "implementation_gate": {"$ref": "#/$defs/implementationGate"},
    "contract_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "refToken": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9._:/-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "targetReceiptSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "schema_path",
        "schema_digest",
        "receipt_definition",
        "receipt_digest_domain"
      ],
      "properties": {
        "schema_id": {"const": "idr.aegis.structured-observation"},
        "schema_version": {"const": 1},
        "schema_path": {
          "const": "contracts/integrations/aegis-life/structured-observation/v1/idr-aegis-structured-observation-v1.schema.json"
        },
        "schema_digest": {"$ref": "#/$defs/digest"},
        "receipt_definition": {"const": "IngressReceiptV1"},
        "receipt_digest_domain": {
          "const": "idr:aegis:structured-observation-receipt:v1"
        }
      }
    },
    "sourceReviewPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit_sha",
        "tree_sha",
        "review_document",
        "review_scope"
      ],
      "properties": {
        "repository": {"const": "Aegis Life"},
        "commit_sha": {"const": "381d14fb1dccfeae691286a39579535ef59f7b4e"},
        "tree_sha": {"const": "da76b01653bb194e4f192e5768b32a38fd3b2173"},
        "review_document": {
          "const": "docs/integrations/IDR-AEGIS-SOURCE-DATA-FLOW-REVIEW.md"
        },
        "review_scope": {"const": "tracked_source_and_documentation_only"}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "created_at_logical_time",
        "valid_from_logical_time",
        "valid_until_logical_time"
      ],
      "properties": {
        "status": {"const": "SPECIFICATION_ONLY"},
        "created_at_logical_time": {"$ref": "#/$defs/safeInteger"},
        "valid_from_logical_time": {"$ref": "#/$defs/safeInteger"},
        "valid_until_logical_time": {"$ref": "#/$defs/safeInteger"}
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_kind",
        "owner_ref",
        "atomic_acceptance_required",
        "delegation_allowed",
        "trust_state",
        "reason_code"
      ],
      "properties": {
        "owner_kind": {"const": "product_ingress_controller"},
        "owner_ref": {"const": "component:aegis-ingress-controller"},
        "atomic_acceptance_required": {"const": true},
        "delegation_allowed": {"const": false},
        "trust_state": {"const": "NOT_IMPLEMENTED"},
        "reason_code": {"const": "NO_APPROVED_OWNER_OR_RECEIPT_SOURCE"}
      }
    },
    "identitySemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uuid_version",
        "canonical_format",
        "mutually_distinct_fields",
        "collision_policy",
        "published_identity_mutation",
        "field_rules"
      ],
      "properties": {
        "uuid_version": {"const": 4},
        "canonical_format": {"const": "lowercase_hyphenated"},
        "mutually_distinct_fields": {
          "const": ["event_id", "run_id", "turn_id", "input_receipt_id"]
        },
        "collision_policy": {"const": "reject_and_regenerate_before_publish"},
        "published_identity_mutation": {"const": "forbidden"},
        "field_rules": {
          "const": [
            {
              "field": "event_id",
              "namespace": "aegis:event",
              "source": "cryptographic_uuid_v4_at_ingress",
              "cardinality": "one_per_accepted_event",
              "reuse_policy": "never",
              "missing_or_invalid": "REJECT_RECEIPT"
            },
            {
              "field": "run_id",
              "namespace": "aegis:run",
              "source": "typed_host_run_context",
              "cardinality": "one_per_host_run",
              "reuse_policy": "same_run_only",
              "missing_or_invalid": "REJECT_RECEIPT"
            },
            {
              "field": "turn_id",
              "namespace": "aegis:turn",
              "source": "typed_interaction_turn_context",
              "cardinality": "one_per_interaction_turn",
              "reuse_policy": "same_turn_only",
              "missing_or_invalid": "REJECT_RECEIPT"
            },
            {
              "field": "input_receipt_id",
              "namespace": "aegis:input-receipt",
              "source": "cryptographic_uuid_v4_at_receipt_seal",
              "cardinality": "one_per_sealed_receipt",
              "reuse_policy": "never",
              "missing_or_invalid": "REJECT_RECEIPT"
            }
          ]
        }
      }
    },
    "actorSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_actor_source",
        "source_actor_taxonomy_ref",
        "free_form_actor_classification",
        "actor_ref_source",
        "actor_ref_namespace",
        "direct_identifier_allowed",
        "unresolved_actor"
      ],
      "properties": {
        "source_actor_source": {"const": "authenticated_typed_origin"},
        "source_actor_taxonomy_ref": {"const": "idr:v1.3:source-actor"},
        "free_form_actor_classification": {"const": "forbidden"},
        "actor_ref_source": {"const": "tenant_scoped_pseudonymization"},
        "actor_ref_namespace": {"const": "aegis:actor"},
        "direct_identifier_allowed": {"const": false},
        "unresolved_actor": {"const": "REJECT_RECEIPT"}
      }
    },
    "contentSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_ref_source",
        "content_ref_namespace",
        "url_or_path_reference_allowed",
        "content_digest_algorithm",
        "digest_preimage",
        "digest_stage",
        "unicode_normalization",
        "raw_content_in_receipt",
        "raw_content_persistence",
        "raw_content_export",
        "raw_content_telemetry",
        "hash_failure"
      ],
      "properties": {
        "content_ref_source": {"const": "fresh_opaque_reference"},
        "content_ref_namespace": {"const": "aegis:content"},
        "url_or_path_reference_allowed": {"const": false},
        "content_digest_algorithm": {"const": "sha256"},
        "digest_preimage": {"const": "exact_received_utf8_bytes"},
        "digest_stage": {"const": "controller_boundary_before_downstream_processing"},
        "unicode_normalization": {"const": "none"},
        "raw_content_in_receipt": {"const": "forbidden"},
        "raw_content_persistence": {"const": "not_authorized"},
        "raw_content_export": {"const": "forbidden"},
        "raw_content_telemetry": {"const": "forbidden"},
        "hash_failure": {"const": "REJECT_RECEIPT"}
      }
    },
    "correlationSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "namespace",
        "meaning",
        "fallback",
        "reuse_policy",
        "goal_text_derivation",
        "semantic_similarity_derivation",
        "idr_output_derivation",
        "authority_semantics"
      ],
      "properties": {
        "source": {"const": "authenticated_typed_upstream_context"},
        "namespace": {"const": "aegis:correlation"},
        "meaning": {"const": "nonsemantic_grouping_only"},
        "fallback": {"const": "fresh_per_input_reference"},
        "reuse_policy": {"const": "explicit_upstream_group_only"},
        "goal_text_derivation": {"const": false},
        "semantic_similarity_derivation": {"const": false},
        "idr_output_derivation": {"const": false},
        "authority_semantics": {"const": "none"}
      }
    },
    "logicalTimeSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clock_kind",
        "clock_ref",
        "epoch_ref",
        "scope",
        "sequence_rule",
        "allocation_stage",
        "atomic_with_receipt_seal",
        "wall_clock_authoritative",
        "journal_time_authoritative",
        "trace_tick_authoritative",
        "rollback_rule",
        "restart_rule",
        "exhaustion_rule",
        "clock_failure",
        "export_verification_clock"
      ],
      "properties": {
        "clock_kind": {"const": "externally_injected_monotonic_logical_clock"},
        "clock_ref": {"const": "clock:aegis-ingress-logical"},
        "epoch_ref": {"const": "epoch:aegis-ingress-v1"},
        "scope": {"const": "source_system"},
        "sequence_rule": {"const": "strictly_increasing_per_source_system"},
        "allocation_stage": {"const": "before_event_publish"},
        "atomic_with_receipt_seal": {"const": true},
        "wall_clock_authoritative": {"const": false},
        "journal_time_authoritative": {"const": false},
        "trace_tick_authoritative": {"const": false},
        "rollback_rule": {"const": "reject_and_require_new_approved_epoch"},
        "restart_rule": {"const": "restore_verified_anchor_or_reject"},
        "exhaustion_rule": {"const": "reject_and_require_new_approved_epoch"},
        "clock_failure": {"const": "REJECT_RECEIPT"},
        "export_verification_clock": {"const": "separate_unresolved_gate"}
      }
    },
    "receiptDigestSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "domain",
        "delimiter",
        "encoding",
        "canonicalization",
        "covered_fields",
        "excluded_fields"
      ],
      "properties": {
        "algorithm": {"const": "sha256"},
        "domain": {"const": "idr:aegis:structured-observation-receipt:v1"},
        "delimiter": {"const": "nul_byte"},
        "encoding": {"const": "utf8"},
        "canonicalization": {"const": "canonical_json"},
        "covered_fields": {
          "const": [
            "event_id",
            "run_id",
            "turn_id",
            "input_receipt_id",
            "source_actor",
            "actor_ref",
            "content_ref",
            "content_digest",
            "correlation_ref",
            "logical_time",
            "schema_version"
          ]
        },
        "excluded_fields": {"const": ["receipt_digest"]}
      }
    },
    "receiptSourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "status",
        "required_fields",
        "digest_domain",
        "creation_mode",
        "verification_stage",
        "missing_or_mismatch"
      ],
      "properties": {
        "schema_id": {"const": "idr.aegis.receipt-source-binding"},
        "schema_version": {"const": 1},
        "status": {"const": "SPECIFIED_NOT_IMPLEMENTED"},
        "required_fields": {
          "const": [
            "schema_id",
            "schema_version",
            "binding_ref",
            "receipt_digest",
            "source_contract_digest",
            "source_review_tree",
            "owner_ref",
            "clock_ref",
            "epoch_ref",
            "bound_at_logical_time",
            "binding_digest"
          ]
        },
        "digest_domain": {"const": "idr:aegis:receipt-source-binding:v1"},
        "creation_mode": {"const": "atomic_with_receipt_acceptance"},
        "verification_stage": {"const": "before_fact_assertion_acceptance"},
        "missing_or_mismatch": {"const": "REJECT_RECEIPT"}
      }
    },
    "implementationGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "assessed_at_logical_time",
        "checks",
        "decision_reason",
        "gate_digest"
      ],
      "properties": {
        "decision": {"const": "BLOCKED"},
        "assessed_at_logical_time": {"$ref": "#/$defs/safeInteger"},
        "checks": {
          "const": [
            {"check": "receipt_source_contract_locked", "status": "SATISFIED", "evidence_refs": ["spec:ingress-receipt-source-v1"]},
            {"check": "source_owner_approved", "status": "UNSATISFIED", "evidence_refs": []},
            {"check": "receipt_implementation_registered", "status": "UNSATISFIED", "evidence_refs": []},
            {"check": "ingress_path_wired", "status": "UNSATISFIED", "evidence_refs": []},
            {"check": "cryptographic_uuid_generation_verified", "status": "UNSATISFIED", "evidence_refs": []},
            {"check": "run_context_binding_verified", "status": "UNSATISFIED", "evidence_refs": []},
            {"check": "turn_context_binding_verified", "status": "UNSATISFIED", "evidence_refs": []},
            {"check": "actor_pseudonymization_verified", "status": "UNSATISFIED", "evidence_refs": []},
            {"check": "exact_content_digest_verified", "status": "UNSATISFIED", "evidence_refs": []},
            {"check": "correlation_semantics_verified", "status": "UNSATISFIED", "evidence_refs": []},
            {"check": "monotonic_clock_injection_verified", "status": "UNSATISFIED", "evidence_refs": []},
            {"check": "rollback_restart_recovery_verified", "status": "UNSATISFIED", "evidence_refs": []},
            {"check": "collision_and_atomicity_tested", "status": "UNSATISFIED", "evidence_refs": []},
            {"check": "receipt_source_binding_implemented", "status": "UNSATISFIED", "evidence_refs": []},
            {"check": "security_privacy_review_passed", "status": "UNSATISFIED", "evidence_refs": []},
            {"check": "cross_language_conformance_passed", "status": "UNSATISFIED", "evidence_refs": []}
          ]
        },
        "decision_reason": {"const": "RECEIPT_SOURCE_NOT_IMPLEMENTED_OR_APPROVED"},
        "gate_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
