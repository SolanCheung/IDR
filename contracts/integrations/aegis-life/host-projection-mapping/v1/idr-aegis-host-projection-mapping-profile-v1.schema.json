{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idr.local/contracts/integrations/aegis-life/host-projection-mapping/v1/idr-aegis-host-projection-mapping-profile-v1.schema.json",
  "title": "AegisHostProjectionMappingProfileV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "mapping_ref",
    "target_projection_schema",
    "source_review_pin",
    "lifecycle",
    "owner",
    "source_snapshot_contract",
    "coordination_mapping",
    "action_mapping",
    "run_state_mapping",
    "consistency_rules",
    "independence_policy",
    "implementation_gate",
    "profile_digest"
  ],
  "properties": {
    "schema_id": {"const": "idr.aegis.host-projection-mapping-profile"},
    "schema_version": {"const": 1},
    "mapping_ref": {"$ref": "#/$defs/refToken"},
    "target_projection_schema": {"$ref": "#/$defs/targetProjectionSchema"},
    "source_review_pin": {"$ref": "#/$defs/sourceReviewPin"},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "owner": {"$ref": "#/$defs/owner"},
    "source_snapshot_contract": {"$ref": "#/$defs/sourceSnapshotContract"},
    "coordination_mapping": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/coordinationMappingEntry"}
    },
    "action_mapping": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/actionMappingEntry"}
    },
    "run_state_mapping": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/runMappingEntry"}
    },
    "consistency_rules": {
      "const": [
        "no_action_requires_response_only",
        "non_response_only_requires_action",
        "waiting_action_requires_waiting_run",
        "waiting_run_requires_waiting_action",
        "blocked_action_requires_declined_run",
        "declined_run_requires_blocked_action"
      ]
    },
    "independence_policy": {"$ref": "#/$defs/independencePolicy"},
    "implementation_gate": {"$ref": "#/$defs/implementationGate"},
    "profile_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "refToken": {
      "type": "string",
      "minLength": 3,
      "maxLength": 180,
      "pattern": "^[a-z0-9][a-z0-9._:/-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "targetProjectionSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "schema_path",
        "schema_digest",
        "projection_definition",
        "required_fields"
      ],
      "properties": {
        "schema_id": {"const": "idr.aegis.structured-observation"},
        "schema_version": {"const": 1},
        "schema_path": {
          "const": "contracts/integrations/aegis-life/structured-observation/v1/idr-aegis-structured-observation-v1.schema.json"
        },
        "schema_digest": {"$ref": "#/$defs/digest"},
        "projection_definition": {"const": "HostProjectionFactsV1"},
        "required_fields": {
          "const": ["coordination_mode", "action_posture", "next_run_state"]
        }
      }
    },
    "sourceReviewPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit_sha", "tree_sha", "review_document", "review_scope"],
      "properties": {
        "repository": {"const": "Aegis Life"},
        "commit_sha": {"const": "381d14fb1dccfeae691286a39579535ef59f7b4e"},
        "tree_sha": {"const": "da76b01653bb194e4f192e5768b32a38fd3b2173"},
        "review_document": {"const": "docs/integrations/IDR-AEGIS-SOURCE-DATA-FLOW-REVIEW.md"},
        "review_scope": {"const": "tracked_source_and_documentation_only"}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "created_at_logical_time", "valid_from_logical_time", "valid_until_logical_time"],
      "properties": {
        "status": {"const": "SPECIFICATION_ONLY"},
        "created_at_logical_time": {"$ref": "#/$defs/safeInteger"},
        "valid_from_logical_time": {"$ref": "#/$defs/safeInteger"},
        "valid_until_logical_time": {"$ref": "#/$defs/safeInteger"}
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_kind", "owner_ref", "trust_state", "reason_code"],
      "properties": {
        "owner_kind": {"const": "aegis_host_decision_runtime"},
        "owner_ref": {"const": "component:aegis-host-decision-runtime"},
        "trust_state": {"const": "NOT_IMPLEMENTED"},
        "reason_code": {"const": "NO_INDEPENDENT_PRODUCT_HOST_SNAPSHOT"}
      }
    },
    "sourceSnapshotContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "schema_path",
        "schema_digest",
        "status",
        "required_fields",
        "digest_domain",
        "capture_order",
        "invalid_snapshot"
      ],
      "properties": {
        "schema_id": {"const": "idr.aegis.host-decision-snapshot"},
        "schema_version": {"const": 1},
        "schema_path": {"const": "contracts/integrations/aegis-life/host-projection-mapping/v1/idr-aegis-host-decision-snapshot-v1.schema.json"},
        "schema_digest": {"$ref": "#/$defs/digest"},
        "status": {"const": "SPECIFIED_NOT_IMPLEMENTED"},
        "required_fields": {
          "const": [
            "schema_id",
            "schema_version",
            "snapshot_ref",
            "receipt_digest",
            "receipt_source_binding_digest",
            "captured_at_logical_time",
            "owner_ref",
            "owner_version",
            "policy_ref",
            "host_coordination_strategy",
            "host_action_state",
            "host_run_phase",
            "idr_output_used",
            "shadow_result_used",
            "snapshot_digest"
          ]
        },
        "digest_domain": {"const": "idr:aegis:host-decision-snapshot:v1"},
        "capture_order": {"const": "after_receipt_before_idr_assessment"},
        "invalid_snapshot": {"const": "REJECT_PROJECTION"}
      }
    },
    "sourceCoordination": {
      "enum": [
        "response_only",
        "action_before_response",
        "response_before_action",
        "response_then_authorization_gate_then_action",
        "parallel_response_and_action",
        "acknowledge_before_background_run",
        "stream_progress_before_final"
      ]
    },
    "targetCoordination": {
      "enum": [
        "respond_only",
        "act_then_respond",
        "respond_then_act",
        "respond_then_confirm_then_act",
        "parallel",
        "acknowledge_then_run",
        "stream_progress_then_final"
      ]
    },
    "sourceAction": {
      "enum": ["no_action", "action_blocked", "action_ready", "action_waiting_authorization"]
    },
    "targetAction": {
      "enum": ["none", "blocked", "planned", "waiting_authorization"]
    },
    "sourceRun": {
      "enum": [
        "queued",
        "executing",
        "waiting_user_input",
        "waiting_action_authorization",
        "waiting_external_dependency",
        "completed",
        "declined",
        "execution_failed",
        "user_cancelled",
        "deadline_exceeded",
        "superseded_or_stale"
      ]
    },
    "targetRun": {
      "enum": [
        "pending",
        "running",
        "waiting_input",
        "waiting_authorization",
        "waiting_dependency",
        "succeeded",
        "rejected",
        "failed",
        "cancelled",
        "timed_out",
        "invalidated"
      ]
    },
    "coordinationMappingEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": {"$ref": "#/$defs/sourceCoordination"},
        "target": {"$ref": "#/$defs/targetCoordination"}
      }
    },
    "actionMappingEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": {"$ref": "#/$defs/sourceAction"},
        "target": {"$ref": "#/$defs/targetAction"}
      }
    },
    "runMappingEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": {"$ref": "#/$defs/sourceRun"},
        "target": {"$ref": "#/$defs/targetRun"}
      }
    },
    "independencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_order",
        "mapping_mode",
        "network_access",
        "database_access",
        "model_call",
        "unknown_value",
        "prohibited_inputs"
      ],
      "properties": {
        "capture_order": {"const": "source_snapshot_before_idr_assessment"},
        "mapping_mode": {"const": "pure_exact_lookup"},
        "network_access": {"const": "forbidden"},
        "database_access": {"const": "forbidden"},
        "model_call": {"const": "forbidden"},
        "unknown_value": {"const": "REJECT_PROJECTION"},
        "prohibited_inputs": {
          "const": [
            "idr_assessment",
            "idr_coordination_mode",
            "idr_action_posture",
            "idr_next_run_state",
            "shadow_comparison_result",
            "shadow_divergence",
            "evaluation_label",
            "chosen_action",
            "execution_result",
            "goal_outcome",
            "journal_record",
            "synthetic_fixture_result"
          ]
        }
      }
    },
    "gateCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "status", "evidence_refs"],
      "properties": {
        "check": {"$ref": "#/$defs/refToken"},
        "status": {"enum": ["SATISFIED", "UNSATISFIED"]},
        "evidence_refs": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/refToken"}
        }
      }
    },
    "implementationGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "assessed_at_logical_time", "checks", "decision_reason", "gate_digest"],
      "properties": {
        "decision": {"const": "BLOCKED"},
        "assessed_at_logical_time": {"$ref": "#/$defs/safeInteger"},
        "checks": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "items": {"$ref": "#/$defs/gateCheck"}
        },
        "decision_reason": {"const": "HOST_PROJECTION_SOURCE_NOT_IMPLEMENTED_OR_APPROVED"},
        "gate_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
