{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "idr.embeddable.decision-contract.v1",
  "title": "IDR Embeddable Decision Contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "intent", "decision", "confidence"],
  "properties": {
    "schema_version": {"const": 1},
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "confidence"],
      "properties": {
        "name": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended_action"],
      "properties": {
        "recommended_action": {"type": "string"}
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
