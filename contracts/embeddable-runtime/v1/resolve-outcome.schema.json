{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idr.dev/contracts/embeddable-runtime/v1/resolve-outcome.schema.json",
  "title": "ResolveOutcomeV1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "decision"],
      "properties": {
        "type": { "const": "decision" },
        "decision": { "$ref": "decision-contract.schema.json" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "model_request"],
      "properties": {
        "type": { "const": "model_inference_required" },
        "model_request": { "$ref": "host-model-request.schema.json" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "unresolved"],
      "properties": {
        "type": { "const": "unresolved" },
        "unresolved": { "$ref": "unresolved-result.schema.json" }
      }
    }
  ]
}
