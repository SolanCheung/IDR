{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idr.dev/contracts/embeddable-runtime/v1/human-model-assertion.schema.json",
  "title": "HumanModelAssertionV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["assertion_id", "subject_ref", "kind", "predicate", "value", "scope", "confidence", "source_type", "evidence_refs", "status", "valid_from", "valid_until", "recorded_at", "last_confirmed_at", "supersedes", "contradicts"],
  "properties": {
    "assertion_id": { "type": "string", "minLength": 1 },
    "subject_ref": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["preference", "constraint", "expertise", "goal", "workflow", "decision_pattern", "interaction_pattern"] },
    "predicate": { "type": "string", "minLength": 1 },
    "value": {},
    "scope": { "$ref": "scope.schema.json" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "source_type": { "enum": ["explicit", "inferred"] },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["candidate", "active", "inactive", "superseded", "contradicted"] },
    "valid_from": { "type": "string" },
    "valid_until": { "type": ["string", "null"] },
    "recorded_at": { "type": "string" },
    "last_confirmed_at": { "type": ["string", "null"] },
    "supersedes": { "type": "array", "items": { "type": "string" } },
    "contradicts": { "type": "array", "items": { "type": "string" } }
  }
}

