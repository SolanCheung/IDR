{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idr.dev/contracts/embeddable-runtime/v1/evidence.schema.json",
  "title": "EvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "kind", "strength", "source", "observed_at", "data"],
  "properties": {
    "evidence_id": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["explicit_statement", "implicit_behavior", "decision_override", "outcome"] },
    "strength": { "type": "number", "minimum": 0, "maximum": 1 },
    "source": { "type": "string" },
    "observed_at": { "type": "string" },
    "data": {}
  }
}

