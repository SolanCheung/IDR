{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idr.dev/contracts/embeddable-runtime/v1/intent-candidate.schema.json",
  "title": "IntentCandidateV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "confidence", "source", "constraints", "evidence_refs"],
  "properties": {
    "intent": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "source": { "enum": ["explicit_user", "host", "host_model", "inferred"] },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" } }
  }
}

